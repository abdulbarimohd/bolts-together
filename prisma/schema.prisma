enum BbShellStandard {
  BSA_68
  BSA_73
  BSA_83
  BSA_100
  ITALIAN_70
  PF92
  PF107
  BB86
  BB90
  T47_68
  T47_73
  /// T47 "internal bearing" — bearings sit inboard of an 85.5mm shell,
  /// vs. T47_68/T47_73's external bearings outboard of a narrower shell.
  /// Verified against Trek's Domane/Checkpoint Gen 3/4 spec (White
  /// Industries' T47 internal/external reference corroborates the width
  /// split). Confirmed missing from the schema while decoding the 99
  /// Spokes export — see scripts/import/99spokes-key.ts.
  T47_85_5
  BB30
  PF30
}

enum SpindleInterface {
  DUB_29
  GXP
  HOLLOWTECH_II_24
  CINCH_30
  BB30_30
  OCT_LINK_24
  SQUARE_TAPER
  ISIS
}

enum BrakeMountType {
  FLAT_MOUNT
  POST_MOUNT_160
  POST_MOUNT_180
  /// Post mount with the rotor size unstated. Native size is set by the
  /// frame/fork's adapter, not the caliper — Shimano and SRAM spec sheets
  /// both publish only "Post mount" for most calipers, never 160 vs 180.
  /// R-BRK-01/02 already treat any POST_MOUNT* value as fitting any other
  /// via a shared-prefix check, so this slots in without touching the engine.
  POST_MOUNT
  IS_MOUNT
  RIM_BRAKE
}

enum AxleType {
  THRU_AXLE_142x12
  THRU_AXLE_148x12_BOOST
  THRU_AXLE_157x12_SUPERBOOST
  THRU_AXLE_110x15_BOOST
  THRU_AXLE_100x15
  /// 12mm-diameter front thru-axle at 100mm spacing -- the standard
  /// front axle on virtually every modern disc-brake road/gravel bike
  /// (Trek/Cannondale/Canyon spec sheets all state "12x100mm thru-axle").
  /// Confirmed missing from the schema while sourcing trim-level forks
  /// and wheelsets: THRU_AXLE_100x15 is a 15mm-diameter MTB standard
  /// (wrong diameter), and no THRU_AXLE_*x12 value at 100mm spacing
  /// existed until now. Do not confuse with THRU_AXLE_100x15.
  THRU_AXLE_100x12
  QUICK_RELEASE_130x9
  QUICK_RELEASE_135x9
  QUICK_RELEASE_100x9
  THRU_AXLE_20x110_DH
  THRU_AXLE_150x12_DH
}

enum AxleThreadPitch {
  M12_x_1_0
  M12_x_1_5
  M12_x_1_75
  M15_x_1_5
  NONE_QR
}

enum DropoutType {
  THRU_AXLE
  QUICK_RELEASE
  UDH
}

enum HeadsetTaper {
  TAPERED_1_5_TO_1_125
  STRAIGHT_1_125
  STRAIGHT_1_5
}

// Upper and lower head tube cups are independent standards.
// EC = external cup, ZS = zero stack, IS = integrated.
enum HeadsetCupStandard {
  EC34
  EC44
  EC49
  ZS44
  ZS49
  ZS56
  IS41
  IS42
  IS52
}

enum WheelDiameter {
  ISO_622 // 700c / 29"
  ISO_584 // 650b / 27.5"
  ISO_559 // 26"
  ISO_507 // 24"
}

enum FreehubBodyType {
  XD
  XDR
  MICRO_SPLINE
  HG_11
  HG_10
  HG_12
  CAMPAGNOLO_N3W
