enum PullDirection {
  TOP_PULL
  BOTTOM_PULL
  DUAL_PULL
  /// Shimano's Side Swing mechanism (from the 11-speed XTR M9000 / XT M8000
  /// era on): cable enters from the front and pulls the arm sideways rather
  /// than up or down, a genuinely different mechanism from top/bottom/dual
  /// pull. https://www.bikeradar.com/advice/buyers-guides/front-derailleur
  SIDE_SWING
}

