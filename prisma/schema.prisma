enum CablePullStandard {
  SHIMANO_ROAD
  SHIMANO_MTB
  SRAM_EXACT_ACTUATION
  SRAM_X_ACTUATION
  SRAM_FULL_PULL
  CAMPAGNOLO
  /// microSHIFT run their own actuation ratios on Advent X and Sword rather
  /// than cloning Shimano's. Their absence blocked two real bikes in the
  /// predecessor (Cannondale Topstone 3 and 4), because a shifter with no
  /// representable pull standard can never match a derailleur.
  MICROSHIFT_ADVENT_X
  MICROSHIFT_SWORD
  ELECTRONIC_AXS
  ELECTRONIC_DI2
  ELECTRONIC_EPS
}

enum FrameMaterial {
