enum ChainringMountStandard {
  BCD_104
  BCD_96
  BCD_94
  BCD_110
  BCD_76
  SRAM_3_BOLT
  RACE_FACE_CINCH
  SHIMANO_DIRECT_MOUNT
  /// SRAM's 8-bolt direct mount, road/gravel chainline (45/47.5mm).
  /// Confirmed NOT interchangeable with the Eagle version below — SRAM's own
  /// support answer: "the chainline for Eagle Transmission (55mm) is
  /// different from our road chainrings (45mm or 47.5mm)... premature wear
  /// or poor shifting." Same bolt count, different standard.
  /// https://support.sram.com/hc/en-us/articles/13822435051931
  SRAM_8_BOLT_ROAD_DM
  /// SRAM's 8-bolt direct mount, Eagle/MTB chainline (55mm). See above.
  SRAM_8_BOLT_EAGLE_DM
}

enum HousingType {
  COMPRESSIONLESS
  STANDARD
}

// ------------------------------------------------------------
// USERS & BUILDS
// ------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  builds      Build[]
  stockAlerts StockAlert[]
}

model Build {
  id        String   @id @default(uuid())
  name      String   @default("Untitled Build")
  /// Null means an anonymous/guest build -- login is optional, not a
  /// gate, so a build can exist before anyone claims it. Anyone who
  /// holds the build's id can view and edit it while it's unclaimed
  /// (the uuid itself is the access token, the same trust model as a
  /// guest shopping cart); POST /builds/:id/claim attaches it to a
  /// real account once the rider chooses to log in.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional rider measurements — the fit rules (R-FIT-*) are
  // advisory and only run when these are supplied.
  riderHeightCm Int?
  riderInseamCm Int?
  riderWeightKg Int?

  // Set when the build was cloned from a factory bike, so the upgrade
  // view can show "stock" against "your choice" and offer a reset.
  basedOnModelId String?
  basedOnModel   BikeModel? @relation(fields: [basedOnModelId], references: [id], onDelete: SetNull)

  buildParts BuildPart[]

  @@index([userId])
}

// ------------------------------------------------------------
// FACTORY BIKES
//
// A complete bike as sold is just a build with every slot filled.
// Modelling it that way means the whole compatibility engine works
// on it unchanged: "what upgrades fit my bike" is the same query as
// "what fits this build".
// ------------------------------------------------------------

model BikeModel {
  id         String   @id @default(uuid())
  brand      String
  model      String
  year       Int
  /// Trim level, e.g. "9.8 XT" — brands sell one model at many specs.
  variant    String?
  slug       String   @unique
  msrpPence  Int?
  /// Discipline: trail, xc, enduro, gravel…
  discipline String?
  createdAt  DateTime @default(now())

  parts  BikeModelPart[]
  builds Build[]
  /// Affiliate offers for the complete bike as sold. This is the half of the
  /// affiliate layer that works even if a retailer's feed turns out to carry
  /// complete bikes only -- see the Phase 7 note at the foot of this file.
  retailerOffers     RetailerOffer[]
  productIdentifiers ProductIdentifier[]

  @@unique([brand, model, year, variant])
  @@index([brand])
}

model BikeModelPart {
  id          String    @id @default(uuid())
  bikeModelId String
  bikeModel   BikeModel @relation(fields: [bikeModelId], references: [id], onDelete: Cascade)
  partId      String
  part        Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  /// 'front' / 'rear' for paired parts, mirroring BuildPart.slot.
  slot        String?

  @@unique([bikeModelId, partId, slot])
  @@index([bikeModelId])
}

model BuildPart {
  id       String   @id @default(uuid())
  buildId  String
  build    Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  partId   String
  part     Part     @relation(fields: [partId], references: [id])
  quantity Int      @default(1)
  // Explicit slot name, so front/rear tyres and rotors no longer
  // depend on insertion order (the v1 simplification).
  slot     String?
  addedAt  DateTime @default(now())

  // Includes `slot`: running the same tyre model front and rear is
  // normal, and a (buildId, partId) unique made that impossible.
  @@unique([buildId, partId, slot])
  @@index([buildId])
}

// ------------------------------------------------------------
// PART — shared base table
// ------------------------------------------------------------

/// The three-way discipline filter surfaced in the header. Deliberately
/// small and closed like every other enum in this schema -- "gravel" is
/// the only genuinely cross-discipline case in the current catalogue
/// (cyclocross/gravel-race frames), and it maps to GRAVEL rather than
/// getting a fourth bucket, matching how the builder UI is scoped to
/// exactly three switch positions.
enum Discipline {
  ROAD
  GRAVEL
  MTB
}

model Part {
  id             String       @id @default(uuid())
  type           PartType
  brand          String
  name           String
  imageUrl       String?
  /// UK RRP in pence, inclusive of VAT.
  /// Null means no published price, not free. Manufacturer spec sheets
  /// (Shimano, SRAM) carry no RRP at all, and inventing one would dress a
  /// gap up as a fact. The UI shows "price unknown" and totals skip it.
  basePricePence Int?
  weightGrams    Int          @default(0)
  releaseDate    DateTime?
  createdAt      DateTime     @default(now())
  /// Which of the header's three discipline filters this part shows
  /// under. Empty means "not yet classified", not "fits nothing" --
  /// the filter treats an empty array as always-shown, the same
  /// abstain-rather-than-hide-inventory choice the compatibility
  /// engine already makes for null spec fields. Most parts will be
  /// empty until a real classification pass tags them; frames are the
  /// one category populated so far, from research already done to
  /// source them, not a guess made just for this field.
  disciplines    Discipline[] @default([])

  // ---- Provenance ----
  /// Defaults to UNVERIFIED so anything inserted without an explicit
  /// source is treated as untrusted rather than silently believed.
  dataSource DataSource @default(UNVERIFIED)
  /// Where the specs were read from, so a claim can be re-checked.
  sourceUrl  String?
  /// Free text for partial verification: which fields were checked,
  /// which are estimates, and anything known to be shaky.
  dataNotes  String?
  /// Set when a human has checked this against the source.
  verifiedAt DateTime?
  verifiedBy String?

  frame            Frame?
  fork             Fork?
  bottomBracket    BottomBracket?
  crankset         Crankset?
  chainring        Chainring?
  wheelset         Wheelset?
  tyre             Tyre?
  tube             Tube?
  brakeCaliper     BrakeCaliper?
  brakeLever       BrakeLever?
  rotor            Rotor?
  shifter          Shifter?
  rearDerailleur   RearDerailleur?
  frontDerailleur  FrontDerailleur?
  cassette         Cassette?
  chain            Chain?
  headset          Headset?
  rearShock        RearShock?
  handlebar        Handlebar?
  stem             Stem?
  seatpost         Seatpost?
  seatClamp        SeatClamp?
  saddle           Saddle?
  pedal            Pedal?
  shoe             Shoe?
  chainGuide       ChainGuide?
  derailleurHanger DerailleurHanger?

  prices         Price[]
  buildParts     BuildPart[]
  bikeModelParts BikeModelPart[]
  stockAlerts    StockAlert[]
  /// Live affiliate offers pointing at this part. See the affiliate layer at
  /// the foot of this file: an offer may carry price, stock and imagery, and
  /// may never write any spec field on this row.
  retailerOffers     RetailerOffer[]
  /// EANs, MPNs and the like. What makes an offer match evidence-based
  /// rather than a fuzzy name guess.
  productIdentifiers ProductIdentifier[]

  // Frame-kit bundling (item 6) -- see PartBundle below. Two relations
  // to the same model, so both ends need their own @relation name:
  // this part as the SKU that ships other parts inside its box, and
  // this part as a component that ships inside some other SKU's box.
  bundlesAsParent    PartBundle[] @relation("BundleParent")
  bundledAsComponent PartBundle[] @relation("BundleIncluded")

  @@index([dataSource])
  @@index([type])
  @@index([brand])
}

// ------------------------------------------------------------
// CATEGORY TABLES
// ------------------------------------------------------------

model Frame {
  partId String @id
  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)

  material               FrameMaterial
  bbShellStandard        BbShellStandard
  /// R-BB-03: kept separate from the standard, because folding width into
  /// the enum hides real mismatches. Decimal, not Int — T47_85_5 shells are
  /// genuinely 85.5mm, which an integer silently truncates.
  bbShellWidthMm         Decimal? @db.Decimal(4, 1)
  rearAxleType           AxleType
  rearAxleThreadPitch    AxleThreadPitch? // R-AXL-03
  rearAxleLengthMm       Int?
  dropoutType            DropoutType? // R-AXL-04
  /// Nullable: manufacturers routinely publish headset bearing part
  /// numbers (e.g. IS44/IS44) without ever stating the taper class
  /// those bearings imply, which isn't a reliable enough mapping to
  /// derive from — see R-HS-01, which abstains when either side is
  /// unknown rather than treating null as "doesn't match."
  headsetTaper           HeadsetTaper?
  headTubeUpperStandard  HeadsetCupStandard? // R-HS-02
  headTubeLowerStandard  HeadsetCupStandard?
  headTubeLengthMm       Int? // R-FRK-01
  rearBrakeMountType     BrakeMountType
  maxRotorMmRear         Int? // R-BRK-04
  wheelDiameter          WheelDiameter
  mulletApproved         Boolean             @default(false) // R-FRK-04
  maxTyreWidthMm         Int // at the given wheelDiameter
  maxTyreWidthMm650b     Int?
  maxChainringTeeth      Int? // R-CRK-02
  maxForkTravelMm        Int? // R-FRK-02
  designAxleToCrownMm    Int? // R-FRK-03
  chainstayLengthMm      Int? // R-DRV-09
  hangerStandard         HangerStandard? // R-HGR-01
  seatpostDiameterMm     Float? // R-SP-01
  seatClampDiameterMm    Float? // R-SP-05
  maxSeatpostInsertionMm Int? // R-SP-03
  seatpostRouting        RoutingType? // R-SP-02
  cableRouting           RoutingType? // R-MNT-02
  iscgStandard           IscgStandard? // R-MNT-01
  bottleMounts           Int? // R-MNT-04
  hasEyelets             Boolean             @default(false) // R-MNT-05
  fdMountType            FdMountType? // R-FD-01
  fdPullDirection        PullDirection? // R-FD-02
  // Rear suspension — all must match a shock exactly (R-SHK-*)
  shockEyeToEyeMm        Int?
  shockStrokeMm          Int?
  shockMountType         ShockMountType?
  shockHardwareWidthMm   Int?
  shockBushingDiameterMm Float?
  leverageRatio          Float?
  suitableForCoil        Boolean?
  // Fit (R-FIT-*)
  frameSize              String?
  standoverMm            Int?
  reachMm                Int?
  stackMm                Int?
  riderMinHeightCm       Int?
  riderMaxHeightCm       Int?

  @@index([bbShellStandard])
  @@index([rearAxleType])
}

model Fork {
  partId String @id
  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)

  steererTubeTaper     HeadsetTaper
  steererLengthMm      Int? // R-FRK-01
  crownRaceDiameterMm  Float? // R-HS-03
  frontAxleType        AxleType
  frontAxleThreadPitch AxleThreadPitch?
  frontAxleLengthMm    Int?
  dropoutType          DropoutType?
  brakeMountType       BrakeMountType
  maxRotorMm           Int? // R-BRK-04
  wheelDiameter        WheelDiameter
  maxTyreWidthMm       Int
  maxTyreWidthMm650b   Int?
  travelMm             Int? // R-FRK-02
  axleToCrownMm        Int? // R-FRK-03
  offsetMm             Int? // R-FRK-06
  isSuspension         Boolean          @default(true) // R-FRK-05

  @@index([frontAxleType])
}

model BottomBracket {
  partId String @id
  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)

  frameInterface   BbShellStandard // must match Frame.bbShellStandard
  /// R-BB-03. Decimal for the same reason as Frame.bbShellWidthMm — 85.5mm
  /// T47 internal shells are a real standard an Int cannot hold.
  shellWidthMm     Decimal? @db.Decimal(4, 1)
  spindleInterface SpindleInterface // must match Crankset.spindleDiameter

  @@index([frameInterface])
}

model Crankset {
  partId String @id
  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)

  spindleDiameter   SpindleInterface
  chainlineType     String
  chainlineMm       Float? // R-CRK-01
  spindleLengthMm   Int? // R-BB-05
  qFactorMm         Int? // R-CRK-03
  crankLengthMm     Int? // R-CRK-04
  pedalThread       PedalThread? // R-PDL-01
  chainringMount    ChainringMountStandard? // R-CHR-01/02
  chainringCount    Int? // R-CHR-04
  maxChainringTeeth Int?
}

model Chainring {
  partId String @id
  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)

  mountStandard ChainringMountStandard // R-CHR-01/02
  boltCount     Int? // R-CHR-01
  teeth         Int
  narrowWide    Boolean                @default(false) // R-CHR-04
  offsetMm      Float? // R-CHR-03
  speeds        Int?
}

model Wheelset {
  partId String @id
  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)

  wheelDiameter      WheelDiameter
  frontAxleType      AxleType
  rearAxleType       AxleType
  freehubBodyType    FreehubBodyType
  // NOTE: v1 typed this as BrakeMountType, which was wrong — a hub's
  // rotor interface is six-bolt or Centerlock, unrelated to how the
  // caliper bolts to the frame.
  rotorMountStandard RotorMountStandard
  tubelessReady      Boolean            @default(false)
  hookless           Boolean            @default(false) // R-TIR-04
  maxPressurePsi     Int? // R-TIR-04
  internalRimWidthMm Int
  rimDepthMm         Int? // R-TIR-07
  valveHoleType      ValveType? // R-TIR-06
  hasBrakeTrack      Boolean            @default(false) // R-BRK-12
