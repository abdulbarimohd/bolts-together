// ============================================================
// prisma/schema.prisma — Bolts Together
//
// Class-table inheritance, same pattern as a PC parts DB: one
// shared `Part` table holds fields every component has (name,
// brand, price, weight), and each category gets its own table
// joined 1:1 via `partId`. Every compatibility-relevant field
// is a closed enum — exact string matching only, no fuzzy
// tolerance between "close" standards (e.g. Boost 148x12 and
// Super Boost 157x12 are NOT compatible despite both being
// "Boost-era").
//
// Field coverage is driven by COMPATIBILITY_RULES.md — each
// rule there names the fields it needs, and every one of them
// exists below. Fields a rule needs but that a given part's
// spec sheet may not publish are nullable: the engine treats
// missing data as "unknown" and degrades to a warning rather
// than guessing.
// ============================================================

generator client {
  // Prisma 7's generator. `runtime = "workerd"` emits a client built for the
  // Cloudflare Workers runtime — the standard Node client assumes TCP sockets
  // and a filesystem, neither of which exist there.
  provider     = "prisma-client"
  output       = "../lib/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
}
// A second client, built for plain Node.
//
// The workerd client above cannot run outside the Workers runtime, and the
// Phase 3 import/sourcing scripts are ordinary Node programs. Rather than
// contort those into a Worker, generate a Node-targeted client alongside it.
// Same schema, same types -- only the runtime shim differs.
generator scripts {
  provider     = "prisma-client"
  output       = "../lib/generated/prisma-node"
  runtime      = "nodejs"
  moduleFormat = "esm"
}


datasource db {
  // No `url` here: Prisma 7 moved connection strings out of the schema.
  // Migration/introspection commands read it from prisma.config.ts; the
  // running app passes a driver adapter to the PrismaClient constructor
  // instead (see lib/db.ts).
  provider = "postgresql"
}

