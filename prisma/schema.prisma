// ------------------------------------------------------------
// PART BUNDLES (item 6 -- frame-kit bundling)
//
// Some frame SKUs ("framesets") are sold as a kit that physically
// includes a specific fork/headset/shock already fitted in the box.
// This is distinct from BikeModel/BikeModelPart above, which models
// "a complete, ridable bike -> every part that ships on it" (a whole
// bike, priced and browsed as one thing). PartBundle instead models
// a Part-to-Part fact: "this exact frameset SKU, picked/bought on
// its own in the builder, physically includes this exact other Part
// in the box." Directional (parent -> bundled), not symmetric -- a
// Fork does not "bundle" the Frame it ships with.
//
// A bundle claim is itself a checkable, sourced fact (it can be
// wrong per trim/year, exactly like any spec field on Part) and gets
// its own provenance trio rather than inheriting the parent Part's,
// because "this frame exists" and "this frame ships with that fork"
// are independently verifiable claims that can come from different
// sources or be checked at different times.
//
// Empty by design as of this migration: no real, sourced frameset
// -kit data (which fork/headset a specific SKU actually ships with)
// has been found yet. The only "*Frameset" Part rows in the current
// catalogue are prisma/seed.ts demo rows marked dataSource UNVERIFIED
// with dataNotes admitting invented geometry -- per the governing
// no-fabrication rule, nothing has been populated against them.
// Populating this table is future sourcing work (see the item 7
// pattern in scripts/import/import-sourced-frames.ts), not guessing.
// ------------------------------------------------------------

model PartBundle {
  id String @id @default(uuid())

  /// The SKU actually sold/picked in the builder -- typically a Frame.
  parentPartId String
  parentPart   Part   @relation("BundleParent", fields: [parentPartId], references: [id], onDelete: Cascade)

  /// The component that ships inside that SKU's box, e.g. a Fork or Headset.
  bundledPartId String
  bundledPart   Part   @relation("BundleIncluded", fields: [bundledPartId], references: [id], onDelete: Cascade)

  quantity Int     @default(1)
  /// e.g. "fork", "headset", "rearShock" -- mirrors the slot naming
  /// already used by BuildPart.slot / BikeModelPart.slot.
  role     String?

  // ---- Provenance (see Part's own provenance fields above for the
  // same reasoning) ----
  /// Defaults to UNVERIFIED, same as Part -- a bundle claim inserted
  /// without an explicit source is untrusted, not silently believed.
  dataSource DataSource @default(UNVERIFIED)
  sourceUrl  String?
  dataNotes  String?

  @@unique([parentPartId, bundledPartId])
  @@index([parentPartId])
  @@index([bundledPartId])
}

// ------------------------------------------------------------
// VENDORS, PRICES, STOCK
// ------------------------------------------------------------

model Vendor {
  id      String     @id @default(uuid())
  name    VendorName @unique
  siteUrl String

  prices      Price[]
  stockAlerts StockAlert[]
}

model Price {
  id       String @id @default(uuid())
  partId   String
  part     Part   @relation(fields: [partId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  // UK retail convention: the figure quoted to the shopper is the
  // VAT-inclusive one, so that's what's stored. Ex-VAT is derived
  // (pricePence / (1 + vatRatePercent/100)) rather than stored, so the
  // two can never drift apart.
  pricePence     Int
  currency       Currency @default(GBP)
  includesVat    Boolean  @default(true)
  vatRatePercent Int      @default(20)
  inStock        Boolean  @default(true)
  productUrl     String
  recordedAt     DateTime @default(now())

  @@index([partId, vendorId, recordedAt])
}

model StockAlert {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  partId           String
  part             Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  vendorId         String?
  /// Was a bare unvalidated String? -- a typo'd or made-up vendorId still
  /// created a real alert row, and since stockAlert.service.ts only ever
  /// looks up prices by (partId, vendorId), that alert could structurally
  /// never match anything and would sit "active" forever without firing.
  /// SetNull rather than Cascade: a vendor being removed shouldn't delete
  /// someone's price/restock alert, just widen it back to "any vendor".
  vendor           Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  targetPricePence Int?
  notifyOnRestock  Boolean   @default(false)
  createdAt        DateTime  @default(now())
  triggeredAt      DateTime?

  @@index([userId])
  @@index([partId])
  @@index([vendorId])
}
