// UK retailers. Canyon sells direct with a UK storefront; the rest are
// UK bike shops with affiliate programmes (mostly via Awin).
enum VendorName {
  CANYON_UK
  TREDZ
  EVANS_CYCLES
  SIGMA_SPORTS
  MERLIN_CYCLES
  /// The one approved affiliate relationship at time of writing (Awin).
  /// Added so the affiliate layer's Retailer can point at a real Vendor row
  /// and keep writing the append-only Price history.
  ///
  /// Note the tension this enum creates with the "adding a network or shop is
  /// configuration, not code" goal: a brand-new *affiliate* retailer needs no
  /// schema change (Retailer.slug is a free string), but linking one to the
  /// pre-existing Vendor/Price history does, because Vendor.name is closed.
  /// Left closed deliberately rather than widened to String -- Vendor is the
  /// small, curated set the price-history and stock-alert features query by
  /// name, and the affiliate layer works fine with Retailer.vendorId null.
  RIBBLE_CYCLES
}

enum Currency {
  GBP
}

/// Where a part's specs came from. A wrong spec fails silently — it
/// hides parts that would have fitted, with no error anywhere — so
/// provenance is recorded per part and surfaced in the UI rather than
/// left implicit.
enum DataSource {
  /// Manufacturer's own spec sheet or tech document. Most trustworthy.
  MANUFACTURER_SPEC
  /// A retailer's product listing. Usually right, occasionally sloppy.
  RETAILER_LISTING
  /// Ingested from an aggregator or affiliate feed.
  DATA_FEED
  /// Submitted by a user; needs corroborating.
  COMMUNITY
  /// Derived or inferred rather than published — e.g. a leverage ratio
  /// worked out from travel figures.
  ESTIMATED
  /// Placeholder data. Plausible-looking but unchecked. Do not trust.
  UNVERIFIED
}

// SRAM Transmission (T-Type) mounts directly to a UDH frame with
// no hanger at all — a hard gate on an entire groupset family.
